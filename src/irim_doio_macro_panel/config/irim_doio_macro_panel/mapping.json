{
  "version": 1,
  "config_name": "default_kb16_mapping",
  "device": {
    "grab": true,
    "reconnect_period_ms": 500,
    "paths": [],
    "match": {
      "name": "DOIO_KB16B",
      "vendor": "0x1915",
      "product": "0xEEEE",
      "uniq": "cc:56:4f:a3:81:30"
    }
  },
  "ros": {
    "topic": "/hmi/robot_command",
    "qos_depth": 10
  },
  "robot_discovery": {
    "enabled": true,
    "method": "ros2_topic_list_subprocess",
    "topic_regex": "^/robot_outbound_data/([^/]+)/",
    "refresh_period_sec": 10.0
  },
  "ui": {
    "window_title": "DOIO Macro → ROS2 Topic Publisher",
    "auto_save_debounce_ms": 250,
    "debug_log_keys": false
  },
  "behavior": {
    "publish_key": "KEY_P",
    "clear_pending_key": "KEY_MUTE",
    "pending_prefix": "",
    "message_format": "{robots}::{suffix}",
    "suppress_base_action_on_chord": true
  },
  "layer": {
    "initial": 0,
    "suppress_base_action_on_indicator": true,
    "indicator_keys": {
      "KEY_F1": 0,
      "KEY_F2": 1,
      "KEY_F3": 2,
      "KEY_F4": 3,
      "KEY_F5": 4,
      "KEY_F6": 5,
      "KEY_F7": 6,
      "KEY_F8": 7,
      "KEY_F9": 8
    }
  },
  "chords": [
    {
      "when_held": [
        "KEY_L"
      ],
      "then_press": "KEY_F",
      "action": {
        "kind": "robot_select_cmd",
        "cmd": "Arm_L_theOne"
      },
      "description": "Arm_L_theOne"
    },
    {
      "when_held": [
        "KEY_L"
      ],
      "then_press": "KEY_G",
      "action": {
        "kind": "robot_select_cmd",
        "cmd": "Arm_R_theOne"
      },
      "description": "Arm_R_theOne"
    },
    {
      "when_held": [
        "KEY_L"
      ],
      "then_press": "KEY_E",
      "action": {
        "kind": "robot_select_cmd",
        "cmd": "Hand_L"
      },
      "description": "Hand_L"
    },
    {
      "when_held": [
        "KEY_L"
      ],
      "then_press": "KEY_H",
      "action": {
        "kind": "robot_select_cmd",
        "cmd": "Hand_R"
      },
      "description": "Hand_R"
    },
    {
      "when_held": [
        "KEY_L"
      ],
      "then_press": "KEY_C",
      "action": {
        "kind": "robot_select_cmd",
        "cmd": "theOne_neck"
